---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';

// Static hosts serve this single pre-rendered file for any unmatched URL, in
// either language, so the page can't detect the visitor's intended locale at
// request time (there is no per-request rendering). The content is therefore
// shown in both languages at once, with links to both localized homepages
// and projects pages, rather than guessing a single locale.
---

<BaseLayout locale="fr" title="Page introuvable · Page not found" description="Cette page n'existe pas ou a été déplacée. This page doesn't exist or has been moved." path="/404" noindex>
  <section class="section notfound">
    <div class="container notfound__inner">
      <Icon name="lucide:search-x" size={48} />

      <div class="notfound__lang">
        <h1>Page introuvable</h1>
        <p class="lede">Cette page n'existe pas ou a été déplacée.</p>
        <div class="notfound__actions">
          <a class="btn btn-primary" href="/fr">Retour à l'accueil</a>
          <a class="btn btn-secondary" href="/fr/projects">Voir les projets</a>
        </div>
      </div>

      <div class="notfound__lang">
        <h1>Page not found</h1>
        <p class="lede">This page doesn't exist or has been moved.</p>
        <div class="notfound__actions">
          <a class="btn btn-primary" href="/en">Back to home</a>
          <a class="btn btn-secondary" href="/en/projects">View projects</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
    padding-block: var(--space-8);
  }

  .notfound__inner > :global(svg) {
    color: var(--color-accent);
  }

  .notfound__lang {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .notfound__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
